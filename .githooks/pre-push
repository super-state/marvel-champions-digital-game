#!/bin/sh
# Require the right check to have passed on what is being pushed. Nothing runs in CI for it, so this hook is the gate.
# Installed by `pnpm install` through the root `prepare` script (`git config core.hooksPath .githooks`). Skip once
# with `git push --no-verify` when you must.
#
# Which check, by what the push changes under `packages/` and `pnpm-lock.yaml`:
#   - nothing there (docs, a script, a changelog fragment), or only new static files in `packages/client/public/`:
#     no check; neither for deleting a branch or pushing a tag;
#   - the rules or cards (`packages/engine/`, `packages/content/`, `packages/cards/`) or `pnpm-lock.yaml`: the tests
#     of what changed that the game we play can reach, then the 3D table's gate (`.githooks/rules-gate.sh`);
#   - anything else under `packages/` (the 3D table, the client code it borrows from the old 2D game, other packages):
#     the 3D table's gate: the type check and its unit tests (`.githooks/battle-gate.sh`). Its browser tests run when
#     a version is cut (`pnpm table:check`, `pnpm table:ship`), not on a push (Adam, 2026-11-23).
# The old 2D game's own browser suite (`pnpm e2e:verify`) is never part of a push (Adam, 2026-11-22: the old game is
# not played; only its rules and cards are used).
#
# `PUSH_GATE_DRY_RUN=1 git push …` prints which check each ref would get, runs none, and refuses the push.
zero="0000000000000000000000000000000000000000"
hooks="$(dirname "$0")"
remote="$1"
rules='^(packages/(engine|content|cards)/|pnpm-lock\.yaml$)'
dry="${PUSH_GATE_DRY_RUN:-}"

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in refs/tags/*) continue ;; esac
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    base="$remote_sha"
  else
    # A new branch: compare with the nearest commit this remote already has, so the commits it carries that were
    # pushed (and checked) before are not checked again. With none, compare with the original project's main.
    base=""
    if [ -n "$remote" ] && [ -n "$(git for-each-ref --count=1 "refs/remotes/$remote")" ]; then
      if [ -z "$(git rev-list --max-count=1 "$local_sha" --not --remotes="$remote" 2>/dev/null)" ]; then
        base="$local_sha" # the remote already has this very commit
      else
        base="$(git rev-list --boundary "$local_sha" --not --remotes="$remote" 2>/dev/null | sed -n 's/^-//p' | head -n 1)"
      fi
    fi
    [ -n "$base" ] || base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
  fi

  gate="rules" # with nothing to compare against, the rules gate tests as if everything changed
  if [ -n "$base" ]; then
    # A file newly added under `packages/client/public/` is left out: a new static file (a font, a picture) cannot
    # change a screen that does not ask for it. A changed or removed one still counts.
    changed="$(git diff --name-status --no-renames "$base" "$local_sha" -- packages pnpm-lock.yaml |
      grep -vE "^A[[:space:]]+packages/client/public/" | cut -f2-)"
    if [ -z "$changed" ]; then
      gate="none"
    elif ! printf '%s\n' "$changed" | grep -qE "$rules"; then
      gate="battle"
    fi
  fi

  if [ -n "$dry" ]; then
    echo "push gate (dry run): $local_ref -> $gate"
    continue
  fi
  case "$gate" in
    none) continue ;;
    battle) sh "$hooks/battle-gate.sh" "$local_sha" "$base" < /dev/null || exit 1 ;;
    *) sh "$hooks/rules-gate.sh" "$local_sha" "$base" < /dev/null || exit 1 ;;
  esac
done

if [ -n "$dry" ]; then
  echo "push gate (dry run): nothing was checked and nothing was pushed." >&2
  exit 1
fi
exit 0
