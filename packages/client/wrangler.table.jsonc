// The 3D table's test site: the version a friend plays (0.0.1, 0.0.2...) while Adam builds the next one on his own PC.
// It lives on Cloudflare Pages, https://champions-table.pages.dev (a Pages address carries no account name, a Worker's
// workers.dev one does), shipped only by `pnpm table:ship` (scripts/ship-table.mjs), never by CI.
//
// This file isn't deployed itself. `table:ship` uses it to bundle the invite lock (src/battle-table/test-site/gate.ts)
// into the build as Pages' `_worker.js`, which then runs first for every request, card scans included. It also runs
// the locked site locally: `pnpm --filter @mc/sync-worker exec wrangler dev --config <this file> --var INVITE_KEY:x`.
//
// Not the original project's `wrangler.game.jsonc` (`mc-game`, its domain marvel.champions-digital-game.com).
{
  "name": "mc-table-test",
  "main": "./src/battle-table/test-site/worker.ts",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true,
  },
  "workers_dev": false,
  "preview_urls": false,
}
